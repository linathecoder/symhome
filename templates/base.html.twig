<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}SymHome{% endblock %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}

    <style>
        body {
            background: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .card {
            border-radius: 15px;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        .btn {
            border-radius: 10px;
        }

        footer {
            margin-top: 50px;
            padding: 20px;
            text-align: center;
            background: #212529;
            color: white;
        }
    </style>

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4">

    <a class="navbar-brand fw-bold text-warning" href="/">
        🏠 SymHome
    </a>

    <div class="ms-auto">

        <a href="/meuble" class="btn btn-outline-light me-2">
            Produits
        </a>

        <a href="/cart" class="btn btn-warning">
            🛒 Panier
        </a>

        <a href="/categorie" class="btn btn-outline-info">
            Catégories
        </a>

    </div>

</nav>

<!-- CONTENT -->
<div class="container mt-4">

    {% block body %}{% endblock %}

</div>

<!-- FOOTER -->
<footer>
    © {{ "now"|date("Y") }} SymHome - All rights reserved
</footer>

</body>
</html>
