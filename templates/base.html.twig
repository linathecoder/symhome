<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SymHome{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/site.css') }}">
</head>
<body>
    <div class="site-shell">
        <header class="site-header">
            <a class="site-brand" href="{{ path('app_meuble_index') }}">SymHome</a>
            <nav class="site-nav">
                <a href="{{ path('app_meuble_index') }}">Boutique</a>
                <a href="{{ path('app_cart') }}">Panier</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}" class="nav-admin">Admin</a>
                {% endif %}
            </nav>
            <div class="site-meta">
                {% if app.user %}
                    <span class="user-chip">{{ app.user.email }}</span>
                {% else %}
                    <span class="user-chip guest">Visiteur</span>
                {% endif %}
            </div>
        </header>
        <main class="site-main">
            {% block body %}{% endblock %}
        </main>
        <footer class="site-footer">
            <span>SymHome • Mobilier contemporain</span>
        </footer>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
    <script src="{{ asset('js/site.js') }}" defer></script>
</body>
</html>
