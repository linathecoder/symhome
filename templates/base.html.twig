<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}SymHome — Mobilier & Décoration{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}SymHome — Votre boutique en ligne de meubles et décoration haut de gamme en Tunisie.{% endblock %}">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}

    <style>
        :root {
            --primary:   #c8a96e;
            --primary-d: #a8834a;
            --dark:      #1a1a2e;
            --dark2:     #16213e;
            --accent:    #e94560;
            --light-bg:  #f8f5f0;
            --card-bg:   #ffffff;
            --text-muted:#7a7a9d;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--light-bg);
            color: #2d2d2d;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main { flex: 1; }

        /* ── NAVBAR ── */
        .navbar-symhome {
            background: var(--dark);
            padding: 0.9rem 2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            position: sticky;
            top: 0;
            z-index: 1050;
        }

        .navbar-brand-logo {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--primary) !important;
            letter-spacing: -0.5px;
            text-decoration: none;
        }

        .navbar-brand-logo span { color: #fff; }

        .nav-link-sym {
            color: rgba(255,255,255,0.8) !important;
            font-weight: 500;
            padding: 0.4rem 0.9rem !important;
            border-radius: 8px;
            transition: all 0.2s;
            text-decoration: none;
        }

        .nav-link-sym:hover, .nav-link-sym.active {
            color: #fff !important;
            background: rgba(200,169,110,0.2);
        }

        .btn-cart {
            background: var(--primary);
            color: #1a1a2e;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            padding: 0.45rem 1.1rem;
            transition: all 0.2s;
        }

        .btn-cart:hover { background: var(--primary-d); color: #fff; transform: translateY(-2px); }

        .cart-badge {
            position: relative;
            display: inline-block;
        }

        /* ── ALERTS / FLASH ── */
        .flash-container { position: fixed; top: 80px; right: 20px; z-index: 9999; min-width: 300px; }

        /* ── CARDS ── */
        .product-card {
            background: var(--card-bg);
            border: none;
            border-radius: 18px;
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.07);
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.15);
        }

        .product-card img {
            height: 220px;
            object-fit: cover;
            width: 100%;
            transition: transform 0.4s;
        }

        .product-card:hover img { transform: scale(1.05); }

        /* ── BUTTONS ── */
        .btn-primary-sym {
            background: linear-gradient(135deg, var(--primary), var(--primary-d));
            border: none;
            color: #1a1a2e;
            font-weight: 700;
            border-radius: 10px;
            padding: 0.55rem 1.4rem;
            transition: all 0.25s;
        }

        .btn-primary-sym:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(200,169,110,0.4); color: #fff; }

        .btn-outline-sym {
            border: 2px solid var(--primary);
            color: var(--primary);
            font-weight: 600;
            border-radius: 10px;
            padding: 0.5rem 1.3rem;
            background: transparent;
            transition: all 0.25s;
        }

        .btn-outline-sym:hover { background: var(--primary); color: #fff; transform: translateY(-2px); }

        /* ── SECTION TITLE ── */
        .section-title {
            font-size: 2rem;
            font-weight: 800;
            color: var(--dark);
        }

        .section-title span { color: var(--primary); }

        .section-line {
            width: 60px;
            height: 4px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 2px;
            margin: 0.5rem auto 2rem;
        }

        /* ── BADGE STATUS ── */
        .badge-en_attente  { background: #ffc107; color: #000; }
        .badge-en_cours    { background: #0dcaf0; color: #000; }
        .badge-completee   { background: #198754; color: #fff; }
        .badge-annulee     { background: #dc3545; color: #fff; }

        /* ── FOOTER ── */
        footer {
            background: var(--dark);
            color: rgba(255,255,255,0.7);
            padding: 2.5rem 1rem 1.5rem;
            margin-top: auto;
        }

        footer .footer-brand { color: var(--primary); font-weight: 800; font-size: 1.4rem; }
        footer a { color: rgba(255,255,255,0.6); text-decoration: none; transition: color 0.2s; }
        footer a:hover { color: var(--primary); }

        /* ── ADMIN SIDEBAR ── */
        .admin-sidebar {
            background: var(--dark2);
            min-height: 100vh;
            padding: 1.5rem 0;
        }

        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            color: rgba(255,255,255,0.7);
            padding: 0.75rem 1.5rem;
            font-weight: 500;
            text-decoration: none;
            border-radius: 0;
            transition: all 0.2s;
        }

        .admin-nav-link:hover, .admin-nav-link.active {
            background: rgba(200,169,110,0.15);
            color: var(--primary);
            border-left: 3px solid var(--primary);
        }

        /* ── FORM STYLES ── */
        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #e0d9cf;
            padding: 0.65rem 1rem;
            font-family: 'Outfit', sans-serif;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(200,169,110,0.2);
        }

        /* ── AUTH CARD ── */
        .auth-card {
            background: #fff;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
            max-width: 480px;
            width: 100%;
        }

        /* ── TABLE ── */
        .table-symhome thead th {
            background: var(--dark2);
            color: rgba(255,255,255,0.85);
            font-weight: 600;
            border: none;
        }

        .table-symhome tbody tr { transition: background 0.15s; }
        .table-symhome tbody tr:hover { background: rgba(200,169,110,0.08); }

        /* Responsive */
        @media (max-width: 768px) {
            .navbar-symhome { padding: 0.7rem 1rem; }
            .section-title  { font-size: 1.5rem; }
        }
    </style>
</head>
<body>

<!-- ══ NAVBAR ══════════════════════════════════════════════════════════════ -->
<nav class="navbar-symhome d-flex align-items-center justify-content-between flex-wrap gap-2">

    <a href="{{ path('app_home') }}" class="navbar-brand-logo">
        🏠 Sym<span>Home</span>
    </a>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a href="{{ path('app_home') }}"       class="nav-link-sym">Accueil</a>
        <a href="{{ path('app_meuble_index') }}" class="nav-link-sym">Produits</a>
        <a href="{{ path('app_categorie_index') }}" class="nav-link-sym">Catégories</a>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_dashboard') }}" class="nav-link-sym" style="color: var(--primary) !important;">
                <i class="bi bi-speedometer2"></i> Admin
            </a>
        {% endif %}

        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('app_commande') }}" class="nav-link-sym">
                <i class="bi bi-bag-check"></i> Mes commandes
            </a>
            <a href="{{ path('app_logout') }}" class="nav-link-sym">
                <i class="bi bi-box-arrow-right"></i> Déconnexion
            </a>
        {% else %}
            <a href="{{ path('app_login') }}"    class="nav-link-sym">Connexion</a>
            <a href="{{ path('app_register') }}" class="btn btn-outline-light btn-sm rounded-3">Inscription</a>
        {% endif %}

        <a href="{{ path('app_cart') }}" class="btn-cart ms-1">
            <i class="bi bi-cart3"></i> Panier
        </a>
    </div>
</nav>

<!-- ══ FLASH MESSAGES ══════════════════════════════════════════════════════ -->
<div class="flash-container">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show shadow" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<!-- ══ CONTENT ══════════════════════════════════════════════════════════════ -->
<main>
    {% block body %}{% endblock %}
</main>

<!-- ══ FOOTER ══════════════════════════════════════════════════════════════ -->
<footer>
    <div class="container">
        <div class="row gy-3">
            <div class="col-md-4">
                <div class="footer-brand mb-2">🏠 SymHome</div>
                <p class="small">Votre destination premium pour meubles et décoration en Tunisie.</p>
            </div>
            <div class="col-md-4">
                <h6 class="text-white fw-bold mb-2">Navigation</h6>
                <div class="d-flex flex-column gap-1">
                    <a href="{{ path('app_home') }}">Accueil</a>
                    <a href="{{ path('app_meuble_index') }}">Produits</a>
                    <a href="{{ path('app_categorie_index') }}">Catégories</a>
                </div>
            </div>
            <div class="col-md-4">
                <h6 class="text-white fw-bold mb-2">Contact</h6>
                <p class="small mb-0"><i class="bi bi-envelope me-1"></i> contact@symhome.tn</p>
                <p class="small"><i class="bi bi-telephone me-1"></i> +216 00 000 000</p>
            </div>
        </div>
        <hr class="border-secondary mt-3">
        <p class="text-center small mb-0">© {{ "now"|date("Y") }} SymHome. Tous droits réservés.</p>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}

<!-- Auto-dismiss flash -->
<script>
    setTimeout(() => {
        document.querySelectorAll('.flash-container .alert').forEach(el => {
            let bs = bootstrap.Alert.getOrCreateInstance(el);
            bs.close();
        });
    }, 4000);
</script>

</body>
</html>
