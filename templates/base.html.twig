<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}SymHome{% endblock %}</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>

<body>

<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('app_home') }}">SymHome</a>

    <div>
        <a href="{{ path('app_meuble_index') }}" class="text-white me-3">Produits</a>
        <a href="{{ path('app_cart') }}" class="text-white me-3">Panier</a>

        {% if app.user %}
            <a href="{{ path('app_commande') }}" class="text-white me-3">Mes commandes</a>
            <a href="{{ path('app_logout') }}" class="text-white">Logout</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="text-white me-3">Login</a>
        {% endif %}
    </div>
</nav>

<div class="container mt-4">
    {% block body %}{% endblock %}
</div>

<footer class="text-center mt-5 py-3 bg-light">
    SymHome © {{ "now"|date("Y") }}
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}

</body>
</html>
