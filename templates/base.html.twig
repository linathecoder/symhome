<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}SymHome{% endblock %}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.4/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/site.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body class="site-shell">

<header class="site-header">
    <a href="{{ path('app_home') }}" class="site-brand">
        <span>SymHome</span>
    </a>

    <nav class="site-nav">
        <a href="{{ path('app_meuble_index') }}">Produits</a>
        <a href="{{ path('app_cart') }}">Panier</a>
        <a href="{{ path('app_categorie_index') }}">Catégories</a>
        {% if app.user %}
            <a href="{{ path('app_commande') }}">Mes commandes</a>
        {% endif %}
        {% if app.user and is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_dashboard') }}">Admin</a>
        {% endif %}
    </nav>

    <div class="site-meta">
        {% if app.user %}
            <span class="user-chip">{{ app.user.prenom ?: app.user.email }}</span>
            <a href="{{ path('app_logout') }}" class="btn btn-secondary">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-secondary">Connexion</a>
            <a href="{{ path('app_register') }}" class="btn btn-primary-sym">Inscription</a>
        {% endif %}
    </div>
</header>

<main class="site-main">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} rounded-3">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="container">
        <p>SymHome © {{ "now"|date('Y') }} — Mobilier premium, design chaleureux.</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}

</body>
</html>
