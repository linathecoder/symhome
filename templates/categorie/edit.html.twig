{% extends 'base.html.twig' %}

{% block title %}Modifier la catégorie{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="card border-0 shadow rounded-4 p-4">
        <h1 class="fw-800 mb-4">Modifier la catégorie</h1>

        {{ include('categorie/_form.html.twig', {'button_label': 'Enregistrer'}) }}

        <div class="d-flex gap-2 flex-wrap mt-4">
            <a href="{{ path('app_categorie_index') }}" class="btn btn-outline-secondary">Retour à la liste</a>
            {{ include('categorie/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
