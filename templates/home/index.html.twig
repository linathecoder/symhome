{% extends 'base.html.twig' %}

{% block title %}SymHome — Mobilier & Décoration Premium{% endblock %}

{% block body %}

<!-- ── HERO ──────────────────────────────────────────────────────────── -->
<section class="hero-section">
    <div class="container hero-inner">
        <div class="hero-copy text-white text-center">
            <span class="eyebrow hero-eyebrow">Bienvenue sur SymHome</span>
            <h1 class="hero-title">
                Votre intérieur,<br>
                <span>notre passion.</span>
            </h1>
            <p class="hero-text">
                Découvrez des milliers de meubles soigneusement sélectionnés pour transformer chaque pièce de votre maison.
            </p>
            <div class="hero-actions">
                <a href="{{ path('app_meuble_index') }}" class="btn btn-primary-sym btn-lg">
                    <i class="bi bi-grid3x3-gap me-2"></i>Découvrir nos produits
                </a>
                <a href="{{ path('app_categorie_index') }}" class="btn btn-outline-light btn-lg">
                    Voir les catégories
                </a>
            </div>

            <div class="hero-stats row gx-4 gy-3 justify-content-center">
                <div class="col-auto">
                    <div class="hero-stat-card">
                        <div class="hero-stat-value">500+</div>
                        <div class="hero-stat-label">Meubles disponibles</div>
                    </div>
                </div>
                <div class="col-auto">
                    <div class="hero-stat-card">
                        <div class="hero-stat-value">6</div>
                        <div class="hero-stat-label">Catégories premium</div>
                    </div>
                </div>
                <div class="col-auto">
                    <div class="hero-stat-card">
                        <div class="hero-stat-value">100%</div>
                        <div class="hero-stat-label">Satisfaction garantie</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── CATEGORIES ─────────────────────────────────────────────────────── -->
<section class="container py-5">
    <div class="text-center mb-4">
        <h2 class="section-title">Nos <span>Catégories</span></h2>
        <div class="section-line mx-auto"></div>
    </div>

    {% set catIcons = {
        'Sejour':  'bi-sofa',
        'Chambre': 'bi-moon-stars',
        'Bureau':  'bi-briefcase',
        'Cuisine': 'bi-egg-fried'
    } %}

    {% set catColors = [
        'linear-gradient(135deg,#667eea,#764ba2)',
        'linear-gradient(135deg,#f093fb,#f5576c)',
        'linear-gradient(135deg,#4facfe,#00f2fe)',
        'linear-gradient(135deg,#43e97b,#38f9d7)'
    ] %}

    <div class="row g-3">
        {% for categorie in categories %}
        <div class="col-6 col-md-3">
            <a href="{{ path('app_meuble_index', {'categorie': categorie.id}) }}" class="text-decoration-none">
                <div class="rounded-4 p-4 text-white text-center h-100"
                     style="background: {{ catColors[loop.index0 % 4] }}; transition:transform 0.3s, box-shadow 0.3s; cursor:pointer;"
                     onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 16px 40px rgba(0,0,0,0.2)'"
                     onmouseout="this.style.transform='';this.style.boxShadow=''">
                    <i class="bi {{ catIcons[categorie.nom] ?? 'bi-house' }}" style="font-size:2.5rem;"></i>
                    <h5 class="fw-700 mt-2 mb-0">{{ categorie.nom }}</h5>
                    <small style="opacity:0.85;">{{ categorie.meubles|length }} article(s)</small>
                </div>
            </a>
        </div>
        {% else %}
        <div class="col-12 text-center text-muted py-4">Aucune catégorie disponible.</div>
        {% endfor %}
    </div>
</section>

<!-- ── FEATURED PRODUCTS ─────────────────────────────────────────────── -->
<section class="py-5" style="background:#fff;">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="section-title">Nouveautés <span>& Tendances</span></h2>
            <div class="section-line mx-auto"></div>
        </div>

        <div class="row g-4">
            {% for meuble in featured %}
            <div class="col-md-4 col-sm-6">
                <div class="product-card h-100 d-flex flex-column">
                    <div style="overflow:hidden;">
                        <img src="/uploads/{{ meuble.image }}" alt="{{ meuble.nom }}">
                    </div>
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        {% if meuble.categorie %}
                        <span class="badge mb-2" style="background:rgba(200,169,110,0.15); color:#a8834a; font-size:0.75rem;">
                            {{ meuble.categorie.nom }}
                        </span>
                        {% endif %}
                        <h5 class="fw-700 mb-1">{{ meuble.nom }}</h5>
                        <p class="text-muted small flex-grow-1">{{ meuble.description|slice(0,80) }}{% if meuble.description|length > 80 %}...{% endif %}</p>
                        <div class="d-flex align-items-center justify-content-between mt-2">
                            <span style="font-size:1.2rem; font-weight:800; color:#c8a96e;">{{ meuble.prix|number_format(2, ',', ' ') }} DT</span>
                            <span class="badge bg-secondary">Stock: {{ meuble.stock }}</span>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <a href="{{ path('app_meuble_show', {'id': meuble.id}) }}" class="btn btn-outline-sym flex-grow-1">
                                <i class="bi bi-eye me-1"></i>Détail
                            </a>
                            <a href="{{ path('cart_add', {'id': meuble.id}) }}" class="btn btn-primary-sym flex-grow-1">
                                <i class="bi bi-cart-plus me-1"></i>Panier
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size:3rem;"></i>
                <p class="mt-2">Aucun produit disponible pour le moment.</p>
            </div>
            {% endfor %}
        </div>

        <div class="text-center mt-4">
            <a href="{{ path('app_meuble_index') }}" class="btn btn-primary-sym px-5 py-3">
                Voir tous les produits <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- ── WHY US ──────────────────────────────────────────────────────────── -->
<section class="container py-5">
    <div class="text-center mb-5">
        <h2 class="section-title">Pourquoi choisir <span>SymHome</span> ?</h2>
        <div class="section-line mx-auto"></div>
    </div>
    <div class="row g-4 text-center">
        {% for item in [
            {'icon':'bi-truck', 'title':'Livraison rapide', 'desc':'Recevez vos meubles chez vous en 48h dans toute la Tunisie.'},
            {'icon':'bi-shield-check', 'title':'Qualité garantie', 'desc':'Chaque meuble est sélectionné pour sa durabilité et son design.'},
            {'icon':'bi-headset', 'title':'Support client', 'desc':'Notre équipe est disponible 6j/7 pour répondre à vos questions.'},
            {'icon':'bi-arrow-counterclockwise', 'title':'Retours faciles', 'desc':'30 jours pour changer d\'avis, sans questions posées.'}
        ] %}
        <div class="col-md-3 col-6">
            <div class="p-4 rounded-4 h-100" style="background:#fff; box-shadow:0 4px 20px rgba(0,0,0,0.06);">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:64px;height:64px;background:rgba(200,169,110,0.12);">
                    <i class="bi {{ item.icon }}" style="font-size:1.6rem;color:#c8a96e;"></i>
                </div>
                <h6 class="fw-700">{{ item.title }}</h6>
                <p class="small text-muted mb-0">{{ item.desc }}</p>
            </div>
        </div>
        {% endfor %}
    </div>
</section>

{% endblock %}
