{% block title %}Boutique{% endblock %}

{% block body %}

<div class="page-intro">
    <span class="eyebrow">Mobilier contemporain</span>
    <h1>Design élégant pour chaque espace</h1>
    <p class="lead">Découvrez une sélection de meubles chics et modernes pour une ambiance raffinée et confortable.</p>
</div>

<div class="product-grid">
    {% for meuble in meubles %}
        <article class="product-card">
            <figure class="product-media">
                <img src="/uploads/{{ meuble.image }}" alt="{{ meuble.nom }}">
            </figure>
            <div class="product-content">
                <h2>{{ meuble.nom }}</h2>
                <p class="product-copy">{{ meuble.description|slice(0, 120) ~ '...' }}</p>
                <div class="product-meta">
                    <span class="price">{{ meuble.prix }} DT</span>
                    <span class="stock">Stock {{ meuble.stock }}</span>
                </div>
                <div class="product-actions">
                    <a href="{{ path('app_meuble_show', {'id': meuble.id}) }}" class="btn btn-primary">Voir</a>
                    <a href="{{ path('cart_add', {'id': meuble.id}) }}" class="btn btn-success">Ajouter</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_meuble_edit', {'id': meuble.id}) }}" class="btn btn-secondary">Modifier</a>
                    {% endif %}
                </div>
            </div>
        </article>
    {% else %}
        <div class="empty-state">Aucun meuble trouvé</div>
    {% endfor %}
</div>

