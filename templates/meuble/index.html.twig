{% block title %}Nos Meubles — SymHome{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="text-center mb-4">
        <h1 class="section-title">Notre <span>Catalogue</span></h1>
        <div class="section-line mx-auto"></div>
        <p class="text-muted">Découvrez notre sélection de meubles pour chaque pièce</p>
    </div>

    <!-- SEARCH & FILTER -->
    <form method="get" action="{{ path('app_meuble_index') }}" class="card border-0 shadow-sm p-4 mb-5 rounded-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-600">🔍 Recherche par nom</label>
                <input type="text" name="search" class="form-control" value="{{ search }}" placeholder="Ex: Canapé, Bureau...">
            </div>
            <div class="col-md-4">
                <label class="form-label fw-600">🏷 Filtrer par catégorie</label>
                <select name="categorie" class="form-select" id="filter-categorie">
                    <option value="">Toutes les catégories</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" {% if categorieId == cat.id %}selected{% endif %}>
                            {{ cat.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-sym flex-grow-1" id="btn-search">
                    <i class="bi bi-search me-1"></i>Filtrer
                </button>
                <a href="{{ path('app_meuble_index') }}" class="btn btn-outline-secondary" id="btn-reset">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </div>
    </form>

    <!-- Admin actions -->
    {% if is_granted('ROLE_ADMIN') %}
    <div class="d-flex justify-content-end mb-3">
        <a href="{{ path('app_meuble_new') }}" class="btn btn-primary-sym" id="btn-add-meuble">
            <i class="bi bi-plus-circle me-1"></i>Ajouter un meuble
        </a>
    </div>
    {% endif %}

    <!-- Results count -->
    <p class="text-muted small mb-3">
        <strong>{{ meubles|length }}</strong> produit(s) trouvé(s)
        {% if search %} pour "<em>{{ search }}</em>"{% endif %}
    </p>

    <!-- PRODUCT GRID -->
    <div class="row g-4">
        {% for meuble in meubles %}
        <div class="col-lg-4 col-md-6">
            <div class="product-card h-100 d-flex flex-column">
                <div style="overflow:hidden; position:relative;">
                    <img src="/uploads/{{ meuble.image }}" alt="{{ meuble.nom }}">
                    {% if meuble.stock == 0 %}
                    <span class="badge bg-danger" style="position:absolute;top:10px;left:10px;">Rupture de stock</span>
                    {% elseif meuble.stock <= 3 %}
                    <span class="badge bg-warning text-dark" style="position:absolute;top:10px;left:10px;">Dernières pièces</span>
                    {% endif %}
                </div>
                <div class="p-3 d-flex flex-column flex-grow-1">
                    {% if meuble.categorie %}
                    <span class="badge mb-2" style="background:rgba(200,169,110,0.15);color:#a8834a;width:fit-content;">
                        {{ meuble.categorie.nom }}
                    </span>
                    {% endif %}
                    <h5 class="fw-700 mb-1">{{ meuble.nom }}</h5>
                    <p class="text-muted small flex-grow-1">
                        {{ meuble.description|slice(0,90) }}{% if meuble.description|length > 90 %}...{% endif %}
                    </p>
                    <div class="d-flex align-items-center justify-content-between mt-2 mb-3">
                        <span style="font-size:1.25rem;font-weight:800;color:#c8a96e;">
                            {{ meuble.prix|number_format(2,',',' ') }} DT
                        </span>
                        <small class="text-muted">Stock: {{ meuble.stock }}</small>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_meuble_show', {'id': meuble.id}) }}"
                           class="btn btn-outline-sym flex-grow-1" id="btn-detail-{{ meuble.id }}">
                            <i class="bi bi-eye me-1"></i>Détail
                        </a>
                        {% if meuble.stock > 0 %}
                        <a href="{{ path('cart_add', {'id': meuble.id}) }}"
                           class="btn btn-primary-sym flex-grow-1" id="btn-cart-{{ meuble.id }}">
                            <i class="bi bi-cart-plus me-1"></i>Panier
                        </a>
                        {% else %}
                        <button class="btn btn-secondary flex-grow-1" disabled>Épuisé</button>
                        {% endif %}
                    </div>
                    {% if is_granted('ROLE_ADMIN') %}
                    <div class="d-flex gap-2 mt-2">
                        <a href="{{ path('app_meuble_edit', {'id': meuble.id}) }}"
                           class="btn btn-warning btn-sm flex-grow-1" id="btn-edit-{{ meuble.id }}">
                            <i class="bi bi-pencil me-1"></i>Modifier
                        </a>
                        <form method="post" action="{{ path('app_meuble_delete', {'id': meuble.id}) }}"
                              onsubmit="return confirm('Supprimer ce meuble ?')" class="flex-grow-1">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ meuble.id) }}">
                            <button class="btn btn-danger btn-sm w-100" id="btn-del-{{ meuble.id }}">
                                <i class="bi bi-trash me-1"></i>Supprimer
                            </button>
                        </form>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center py-5">
            <i class="bi bi-inbox" style="font-size:4rem; color:#dee2e6;"></i>
            <p class="text-muted mt-3 fs-5">Aucun meuble trouvé.</p>
            <a href="{{ path('app_meuble_index') }}" class="btn btn-outline-sym">Voir tous les produits</a>
        </div>
        {% endfor %}
    </div>
</div>
