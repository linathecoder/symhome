{% extends 'base.html.twig' %}

{% block title %}Nos Meubles — SymHome{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="text-center mb-4">
        <h1 class="section-title">Notre <span>Catalogue</span></h1>
        <div class="section-line mx-auto"></div>
        <p class="text-muted">Découvrez notre sélection de meubles pour chaque pièce</p>
    </div>

    <!-- SEARCH & FILTER -->
    <form method="get" action="{{ path('app_meuble_index') }}" class="card border-0 shadow-sm p-4 mb-5 rounded-4">
        <div class="row g-3 align-items-end">

            <div class="col-md-5">
                <label class="form-label">Recherche</label>
                <input type="text" name="search" class="form-control" value="{{ search }}">
            </div>

            <div class="col-md-4">
                <label class="form-label">Catégorie</label>
                <select name="categorie" class="form-select">
                    <option value="">Toutes</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" {% if categorieId == cat.id %}selected{% endif %}>
                            {{ cat.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary-sym w-100">Filtrer</button>
                <a href="{{ path('app_meuble_index') }}" class="btn btn-outline-secondary">Reset</a>
            </div>

        </div>
    </form>

    {% if is_granted('ROLE_ADMIN') %}
    <div class="text-end mb-3">
        <a href="{{ path('app_meuble_new') }}" class="btn btn-primary-sym">
            Ajouter un meuble
        </a>
    </div>
    {% endif %}

    <!-- PRODUCTS -->
    <div class="row g-4">

        {% for meuble in meubles %}
        <div class="col-lg-4 col-md-6">

            <div class="product-card">

                <img src="/uploads/{{ meuble.image }}" alt="{{ meuble.nom }}">

                <div class="p-3">

                    <h5>{{ meuble.nom }}</h5>

                    <p class="text-muted small">
                        {{ meuble.description|slice(0,100) }}...
                    </p>

                    <div class="d-flex justify-content-between">
                        <strong style="color:#c8a96e;">
                            {{ meuble.prix }} DT
                        </strong>
                        <small>Stock: {{ meuble.stock }}</small>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <a href="{{ path('app_meuble_show', {'id': meuble.id}) }}"
                           class="btn btn-outline-sym w-50">
                            Voir
                        </a>

                        <a href="{{ path('cart_add', {'id': meuble.id}) }}"
                           class="btn btn-primary-sym w-50">
                            Panier
                        </a>
                    </div>

                    {% if is_granted('ROLE_ADMIN') %}
                    <div class="mt-2 d-flex gap-2">
                        <a href="{{ path('app_meuble_edit', {'id': meuble.id}) }}"
                           class="btn btn-warning btn-sm w-50">
                            Modifier
                        </a>
                        <form method="post"
                              action="{{ path('app_meuble_delete', {'id': meuble.id}) }}"
                              class="w-50"
                              onsubmit="return confirm('Supprimer ?')">
                            <button class="btn btn-danger btn-sm w-100">Supprimer</button>
                        </form>
                    </div>
                    {% endif %}

                </div>
            </div>

        </div>
        {% else %}
        <div class="text-center py-5">
            <p>Aucun meuble trouvé</p>
        </div>
        {% endfor %}

    </div>

</div>
{% endblock %}
