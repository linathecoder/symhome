{% extends 'base.html.twig' %}
{% block title %}{{ meuble.nom }} — SymHome{% endblock %}

{% block body %}
<div class="container py-5">
    <a href="{{ path('app_meuble_index') }}" class="btn btn-outline-secondary mb-4">
        <i class="bi bi-arrow-left me-1"></i>Retour au catalogue
    </a>

    <div class="row g-5 align-items-start">
        <!-- IMAGE -->
        <div class="col-md-6">
            <div class="rounded-4 overflow-hidden shadow-lg" style="max-height:480px;">
                <img src="/uploads/{{ meuble.image }}" alt="{{ meuble.nom }}"
                     class="w-100 h-100" style="object-fit:cover; max-height:480px;">
            </div>
        </div>

        <!-- DETAILS -->
        <div class="col-md-6">
            {% if meuble.categorie %}
            <a href="{{ path('app_meuble_index', {'categorie': meuble.categorie.id}) }}"
               class="badge mb-3 text-decoration-none"
               style="background:rgba(200,169,110,0.15);color:#a8834a;font-size:0.85rem;padding:0.5em 1em;border-radius:20px;">
                <i class="bi bi-tag me-1"></i>{{ meuble.categorie.nom }}
            </a>
            {% endif %}

            <h1 class="fw-800 mb-2" style="font-size:2rem;">{{ meuble.nom }}</h1>

            <div class="mb-3" style="font-size:2rem; font-weight:800; color:#c8a96e;">
                {{ meuble.prix|number_format(2,',',' ') }} <small style="font-size:1rem;color:#888;">DT</small>
            </div>

            <p class="text-muted mb-4" style="line-height:1.8;">{{ meuble.description }}</p>

            <div class="d-flex gap-3 mb-4 flex-wrap">
                <div class="rounded-3 px-4 py-3 text-center" style="background:#f8f5f0; flex:1;">
                    <div style="font-size:1.4rem; font-weight:700; color:{% if meuble.stock > 0 %}#198754{% else %}#dc3545{% endif %};">
                        {{ meuble.stock }}
                    </div>
                    <div class="small text-muted">En stock</div>
                </div>
                {% if meuble.categorie %}
                <div class="rounded-3 px-4 py-3 text-center" style="background:#f8f5f0; flex:1;">
                    <div style="font-size:1.4rem;">🏷</div>
                    <div class="small text-muted">{{ meuble.categorie.nom }}</div>
                </div>
                {% endif %}
            </div>

            {% if meuble.stock > 0 %}
            <a href="{{ path('cart_add', {'id': meuble.id}) }}"
               class="btn btn-primary-sym w-100 py-3 fw-700 mb-3" id="btn-add-cart-{{ meuble.id }}"
               style="font-size:1.1rem;">
                <i class="bi bi-cart-plus me-2"></i>Ajouter au panier
            </a>
            {% else %}
            <button class="btn btn-secondary w-100 py-3 mb-3" disabled>
                <i class="bi bi-x-circle me-2"></i>Rupture de stock
            </button>
            {% endif %}

            <a href="{{ path('app_meuble_index') }}" class="btn btn-outline-sym w-100">
                Continuer vos achats
            </a>

            {% if is_granted('ROLE_ADMIN') %}
            <div class="d-flex gap-2 mt-3">
                <a href="{{ path('app_meuble_edit', {'id': meuble.id}) }}"
                   class="btn btn-warning flex-grow-1" id="btn-edit-{{ meuble.id }}">
                    <i class="bi bi-pencil me-1"></i>Modifier
                </a>
                <form method="post" action="{{ path('app_meuble_delete', {'id': meuble.id}) }}"
                      onsubmit="return confirm('Supprimer ?')" class="flex-grow-1">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ meuble.id) }}">
                    <button class="btn btn-danger w-100" id="btn-del-{{ meuble.id }}">
                        <i class="bi bi-trash me-1"></i>Supprimer
                    </button>
                </form>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
