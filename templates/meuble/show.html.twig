{% extends 'base.html.twig' %}

{% block title %}{{ meuble.nom }}{% endblock %}

{% block body %}

<div class="page-intro">
    <h1>{{ meuble.nom }}</h1>
    <p class="lead">Détails du meuble et ajout rapide au panier.</p>
</div>

<div class="card">
    <img src="/uploads/{{ meuble.image }}" alt="{{ meuble.nom }}" style="width:100%; height:420px; object-fit:cover; border-radius:1.5rem 1.5rem 0 0;">
    <div class="product-content" style="padding:2rem;">
        <div style="display:grid; gap:1rem;">
            <div style="display:flex; flex-wrap:wrap; gap:1rem; justify-content:space-between; align-items:center;">
                <h2>{{ meuble.nom }}</h2>
                <span class="price">{{ meuble.prix }} DT</span>
            </div>
            <p>{{ meuble.description }}</p>
            <div class="product-meta">
                <span class="stock">Stock {{ meuble.stock }}</span>
                <span>{{ meuble.categorie.nom }}</span>
            </div>
            <div class="product-actions">
                <a href="{{ path('cart_add', {'id': meuble.id}) }}" class="btn btn-success">Ajouter au panier</a>
                <a href="{{ path('app_meuble_index') }}" class="btn btn-secondary">Retour</a>
            </div>
        </div>
    </div>
</div>

{% endblock %}
