{% extends 'base.html.twig' %}

{% block title %}{{ meuble.nom }} — SymHome{% endblock %}

{% block body %}
<div class="container py-5">
    <a href="{{ path('app_meuble_index') }}" class="btn btn-outline-secondary mb-4">
        <i class="bi bi-arrow-left me-1"></i>Retour au catalogue
    </a>

    <div class="row g-5 align-items-start">
        <div class="col-lg-6">
            <div class="rounded-4 overflow-hidden shadow-lg" style="min-height:420px;">
                <img src="/uploads/{{ meuble.image ?: 'default.jpg' }}" alt="{{ meuble.nom }}"
                     class="w-100 h-100" style="object-fit:cover; min-height:420px;">
            </div>
        </div>
        <div class="col-lg-6">
            {% if meuble.categorie %}
                <span class="badge badge-secondary mb-3">{{ meuble.categorie.nom }}</span>
            {% endif %}
            <h1 class="fw-800 mb-3">{{ meuble.nom }}</h1>
            <div class="mb-4" style="font-size:2rem; color:#c8a96e; font-weight:800;">
                {{ meuble.prix|number_format(2, ',', ' ') }} DT
            </div>
            <p class="text-muted mb-4" style="line-height:1.8;">{{ meuble.description }}</p>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <div class="card p-3 h-100 text-center" style="background:#f8f5f0;">
                        <div class="fs-4 fw-700" style="color:{{ meuble.stock > 0 ? '#198754' : '#dc3545' }};">
                            {{ meuble.stock }}
                        </div>
                        <div class="small text-muted">En stock</div>
                    </div>
                </div>
                {% if meuble.categorie %}
                <div class="col-sm-6">
                    <div class="card p-3 h-100 text-center" style="background:#f8f5f0;">
                        <div class="fs-4 fw-700">🏷</div>
                        <div class="small text-muted">{{ meuble.categorie.nom }}</div>
                    </div>
                </div>
                {% endif %}
            </div>

            {% if meuble.stock > 0 %}
                <a href="{{ path('cart_add', {'id': meuble.id}) }}" class="btn btn-primary-sym w-100 py-3 mb-3">
                    <i class="bi bi-cart-plus me-2"></i>Ajouter au panier
                </a>
            {% else %}
                <button class="btn btn-secondary w-100 py-3 mb-3" disabled>
                    <i class="bi bi-x-circle me-2"></i>Rupture de stock
                </button>
            {% endif %}

            <a href="{{ path('app_meuble_index') }}" class="btn btn-outline-sym w-100">
                Continuer vos achats
            </a>

            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2 mt-4 flex-wrap">
                    <a href="{{ path('app_meuble_edit', {'id': meuble.id}) }}" class="btn btn-warning flex-grow-1">
                        <i class="bi bi-pencil me-1"></i>Modifier
                    </a>
                    <form method="post" action="{{ path('app_meuble_delete', {'id': meuble.id}) }}" class="flex-grow-1" onsubmit="return confirm('Supprimer ce meuble ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ meuble.id) }}">
                        <button class="btn btn-danger w-100">
                            <i class="bi bi-trash me-1"></i>Supprimer
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
