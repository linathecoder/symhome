{% extends 'base.html.twig' %}
{% block title %}Modifier {{ meuble.nom }} — Admin{% endblock %}

{% block body %}
<div class="container py-5" style="max-width:700px;">
    <h1 class="fw-800 mb-4">
        <i class="bi bi-pencil-square me-2" style="color:#c8a96e;"></i>Modifier : {{ meuble.nom }}
    </h1>

    <div class="card border-0 shadow rounded-4 p-4">
        <!-- Current image -->
        {% if meuble.image %}
        <div class="mb-3 text-center">
            <p class="text-muted small mb-1">Image actuelle :</p>
            <img src="/uploads/{{ meuble.image }}" alt="{{ meuble.nom }}"
                 class="rounded-3" style="max-height:180px; object-fit:cover;">
        </div>
        {% endif %}

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.prix) }}
        {{ form_row(form.description) }}
        {{ form_row(form.stock) }}
        {{ form_row(form.categorie) }}
        {{ form_row(form.imageFile) }}

        <div class="d-flex gap-3 mt-4">
            <button type="submit" id="btn-update-meuble" class="btn btn-primary-sym px-5">
                <i class="bi bi-save me-1"></i>Mettre à jour
            </button>
            <a href="{{ path('admin_catalogue') }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
