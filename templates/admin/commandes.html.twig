{% extends 'base.html.twig' %}
{% block title %}Commandes — Admin SymHome{% endblock %}

{% block body %}
<div class="d-flex">
    <aside class="admin-sidebar" style="width:240px; min-width:240px;">
        <div class="px-4 py-3 mb-2">
            <span style="color:#c8a96e; font-weight:800; font-size:1.1rem;">Admin Panel</span>
        </div>
        <a href="{{ path('admin_dashboard') }}" class="admin-nav-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a href="{{ path('admin_commandes') }}" class="admin-nav-link active"><i class="bi bi-bag-check"></i> Commandes</a>
        <a href="{{ path('admin_catalogue') }}" class="admin-nav-link"><i class="bi bi-grid3x3-gap"></i> Catalogue</a>
        <a href="{{ path('admin_users') }}" class="admin-nav-link"><i class="bi bi-people"></i> Utilisateurs</a>
        <a href="{{ path('app_categorie_index') }}" class="admin-nav-link"><i class="bi bi-tags"></i> Catégories</a>
        <hr style="border-color:rgba(255,255,255,0.1); margin:1rem;">
        <a href="{{ path('app_home') }}" class="admin-nav-link"><i class="bi bi-house"></i> Voir la boutique</a>
    </aside>

    <main style="flex:1; padding:2rem; background:#f8f5f0;">
        <h1 class="fw-800 mb-4" style="color:#1a1a2e;">Gestion des commandes</h1>

        <div class="bg-white rounded-4 shadow-sm p-3">
            <table class="table table-symhome mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Client</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Statut</th>
                        <th>Changer statut</th>
                    </tr>
                </thead>
                <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td><strong>#{{ commande.id }}</strong></td>
                        <td>
                            {% if commande.user %}
                                {{ commande.user.prenom }} {{ commande.user.nom }}<br>
                                <small class="text-muted">{{ commande.user.email }}</small>
                            {% else %}
                                <span class="text-muted">Client supprime</span>
                            {% endif %}
                        </td>
                        <td>{{ commande.date|date('d/m/Y H:i') }}</td>
                        <td><strong style="color:#c8a96e;">{{ commande.total|number_format(2,',',' ') }} DT</strong></td>
                        <td>

                            <span class="badge badge-{{ commande.status }}">
                                {{ commande.status|replace({'_':' '})|capitalize }}
                            </span>
                        </td>
                        <td>
                            <form method="post" action="{{ path('admin_commande_status', {'id': commande.id}) }}" class="d-flex gap-1">
                                <select name="status" class="form-select form-select-sm" style="width:130px;">
                                    {% for s in ['en_attente','payee','en_cours','completee','annulee'] %}
                                    <option value="{{ s }}" {% if commande.status == s %}selected{% endif %}>
                                        {{ s|replace({'_':' '})|capitalize }}
                                    </option>
                                    {% endfor %}
                                </select>
                                <button class="btn btn-sm btn-primary-sym">OK</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted py-4">Aucune commande.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </main>
</div>
{% endblock %}
