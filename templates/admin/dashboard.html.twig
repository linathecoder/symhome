{% extends 'base.html.twig' %}
{% block title %}Dashboard Admin — SymHome{% endblock %}

{% block body %}
<section class="admin-dashboard-hero">
    <div class="container">
        <div class="hero-panel rounded-4 p-4 p-lg-5">
            <div class="row align-items-center gy-4">
                <div class="col-lg-8">
                    <span class="eyebrow hero-eyebrow">Tableau de bord admin</span>
                    <h1 class="hero-title mb-3">Bienvenue dans l’espace de gestion</h1>
                    <p class="hero-text mb-4">Supervisez les commandes, gérez les produits et gardez le contrôle de l’expérience client depuis un tableau de bord clair et premium.</p>
                    <div class="hero-actions justify-content-start flex-wrap">
                        <a href="{{ path('admin_commandes') }}" class="btn btn-primary-sym btn-lg">
                            <i class="bi bi-bag-check me-2"></i>Commandes
                        </a>
                        <a href="{{ path('admin_catalogue') }}" class="btn btn-outline-light btn-lg">
                            <i class="bi bi-grid3x3-gap me-2"></i>Catalogue
                        </a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="dashboard-hero-card p-4 rounded-4">
                        <div class="small text-muted mb-3">Résumé rapide</div>
                        <div class="dashboard-hero-summary mb-4">
                            <div class="dashboard-hero-caption">Revenu total</div>
                            <div class="dashboard-hero-value">{{ ca|number_format(0,',',' ') }} DT</div>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="hero-stat-card text-center">
                                    <div class="hero-stat-value">{{ nbCommandes }}</div>
                                    <div class="hero-stat-label">Commandes</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="hero-stat-card text-center">
                                    <div class="hero-stat-value">{{ nbUsers }}</div>
                                    <div class="hero-stat-label">Clients</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="row g-4">
        <aside class="col-lg-3">
            <div class="admin-sidebar rounded-4 p-4 shadow-sm">
                <div class="mb-4">
                    <div class="fs-5 fw-700">SymHome Admin</div>
                    <p class="small text-muted mb-0">Accès rapides</p>
                </div>
                <nav class="admin-nav">
                    <a href="{{ path('admin_dashboard') }}" class="admin-nav-link active">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                    <a href="{{ path('admin_commandes') }}" class="admin-nav-link">
                        <i class="bi bi-bag-check me-2"></i> Commandes
                    </a>
                    <a href="{{ path('admin_catalogue') }}" class="admin-nav-link">
                        <i class="bi bi-grid3x3-gap me-2"></i> Catalogue
                    </a>
                    <a href="{{ path('admin_users') }}" class="admin-nav-link">
                        <i class="bi bi-people me-2"></i> Utilisateurs
                    </a>
                    <a href="{{ path('app_categorie_index') }}" class="admin-nav-link">
                        <i class="bi bi-tags me-2"></i> Catégories
                    </a>
                    <a href="{{ path('app_home') }}" class="admin-nav-link mt-3">
                        <i class="bi bi-house me-2"></i> Voir la boutique
                    </a>
                </nav>
            </div>
        </aside>

        <main class="col-lg-9">
            <div class="admin-main rounded-4 p-4 shadow-sm bg-white">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="card card-stat">
                            <div class="small text-muted mb-2">Chiffre d'affaires</div>
                            <div class="fs-3 fw-800">{{ ca|number_format(2, ',', ' ') }} DT</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card card-stat">
                            <div class="small text-muted mb-2">Clients inscrits</div>
                            <div class="fs-3 fw-800">{{ nbUsers }}</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card card-stat">
                            <div class="small text-muted mb-2">Commandes totales</div>
                            <div class="fs-3 fw-800">{{ nbCommandes }}</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card card-stat">
                            <div class="small text-muted mb-2">Produits disponibles</div>
                            <div class="fs-3 fw-800">{{ nbMeubles }}</div>
                        </div>
                    </div>
                </div>

                <div class="card rounded-4 p-4 mb-4 border-0 shadow-sm">
                    <h5 class="fw-700 mb-3">Vue synthétique</h5>
                    <p class="text-muted mb-0">Les statistiques avancées seront disponibles dès que les indicateurs de commande et de chiffre d’affaires seront intégrés au contrôleur.</p>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <a href="{{ path('app_meuble_new') }}" class="btn btn-primary-sym w-100 py-3">
                            <i class="bi bi-plus-circle me-2"></i>Ajouter un meuble
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="{{ path('admin_commandes') }}" class="btn btn-outline-sym w-100 py-3">
                            <i class="bi bi-list-check me-2"></i>Gérer les commandes
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="{{ path('app_categorie_new') }}" class="btn btn-outline-secondary w-100 py-3">
                            <i class="bi bi-tag me-2"></i>Nouvelle catégorie
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
// Aucun graphique détaillé disponible dans cette version du tableau de bord.
</script>
{% endblock %}
