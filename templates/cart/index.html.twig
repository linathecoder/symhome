{% extends 'base.html.twig' %}

{% block title %}Mon Panier — SymHome{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="text-center mb-4">
        <h1 class="section-title">Mon <span>Panier</span></h1>
        <div class="section-line mx-auto"></div>
    </div>

    {% if items is empty %}
        <div class="text-center py-5">
            <i class="bi bi-cart-x" style="font-size:4rem; color:#dee2e6;"></i>
            <p class="text-muted mt-3 fs-5">Votre panier est vide.</p>
            <a href="{{ path('app_meuble_index') }}" class="btn btn-primary-sym px-5 mt-2">
                Voir notre catalogue
            </a>
        </div>
    {% else %}
        <div class="row g-4">

            <div class="col-lg-8">
                <div class="bg-white rounded-4 shadow-sm p-4">

                    {% for item in items %}
                        <div class="d-flex align-items-center gap-3 py-3 {% if not loop.last %}border-bottom{% endif %}">

                            <img src="/uploads/{{ item.meuble.image }}"
                                 style="width:80px;height:80px;object-fit:cover;border-radius:12px;">

                            <div class="flex-grow-1">
                                <h6 class="mb-1">{{ item.meuble.nom }}</h6>
                                <div style="color:#c8a96e;font-weight:700;">
                                    {{ item.meuble.prix }} DT
                                </div>
                            </div>

                            <div class="fw-bold">
                                {{ item.sousTotal ?? (item.meuble.prix * item.quantity) }} DT
                            </div>

                            <a href="{{ path('cart_remove', {'id': item.meuble.id}) }}"
                               class="btn btn-sm btn-danger">
                                Supprimer
                            </a>
                        </div>
                    {% endfor %}

                </div>
            </div>

            <div class="col-lg-4">
                <div class="bg-white rounded-4 shadow-sm p-4">

                    <h5>Résumé</h5>

                    <hr>

                    <div class="fw-bold fs-5">
                        Total : {{ total }} DT
                    </div>

                    {% if app.session.get('user_id') %}
                        <a href="{{ path('app_checkout') }}" class="btn btn-primary-sym w-100 mt-3">
                            Passer au paiement
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-primary-sym w-100 mt-3">
                            Se connecter
                        </a>
                    {% endif %}

                </div>
            </div>

        </div>
    {% endif %}

</div>
{% endblock %}
