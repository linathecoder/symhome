                                </div>
                            </div>
                        </td>
                        <td>{{ item.meuble.prix }} DT</td>
                        <td>{{ item.qty }}</td>
                        <td><strong>{{ sousTotal }} DT</strong></td>
                        <td><a href="{{ path('cart_remove', {'id': item.meuble.id}) }}" class="btn btn-danger">Supprimer</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <div class="product-actions" style="justify-content:flex-end;">
