    <p class="lead">Regardez vos articles sélectionnés et finalisez votre commande en quelques clics.</p>
</div>

{% if items is empty %}
    <div class="alert">Votre panier est vide</div>
{% else %}
    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Prix</th>
                    <th>Quantité</th>
                    <th>Sous-total</th>
                    <th>Action</th>
                </tr>
            </thead>
