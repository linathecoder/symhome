{% extends 'base.html.twig' %}

{% block title %}Liste des commandes{% endblock %}

{% block body %}

<div class="container mt-5">

    <h1 class="mb-4">Liste des commandes</h1>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>ID</th>
                <th>Date</th>
                <th>Status</th>
                <th>Total</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

        {% for commande in commandes %}

            <tr>

                <td>{{ commande.id }}</td>

                <td>
                    {{ commande.date|date('d/m/Y') }}
                </td>

                <td>{{ commande.status }}</td>

                <td>{{ commande.total }} DT</td>

                <td>

                    <a href="{{ path('commande_show', {'id': commande.id}) }}"
                       class="btn btn-info">
                        Voir
                    </a>

                    <a href="{{ path('commande_delete', {'id': commande.id}) }}"
                       class="btn btn-danger">
                        Supprimer
                    </a>

                </td>

            </tr>

        {% else %}

            <tr>
                <td colspan="5">
                    Aucune commande trouvée
                </td>
            </tr>

        {% endfor %}

        </tbody>

    </table>

</div>

{% endblock %}
