{% extends 'base.html.twig' %}

{% block title %}Détail commande{% endblock %}

{% block body %}

<div class="container mt-5">

    <h1>Détail Commande</h1>

    <ul class="list-group">

        <li class="list-group-item">
            ID : {{ commande.id }}
        </li>

        <li class="list-group-item">
            Date :
            {{ commande.date|date('d/m/Y') }}
        </li>

        <li class="list-group-item">
            Status : {{ commande.status }}
        </li>

        <li class="list-group-item">
            Total : {{ commande.total }} DT
        </li>

    </ul>

    <a href="{{ path('app_commande') }}"
       class="btn btn-primary mt-3">
       Retour
    </a>

</div>

{% endblock %}
