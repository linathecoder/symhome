{% extends 'base.html.twig' %}

{% block title %}Connexion - SymHome{% endblock %}

{% block body %}

<div class="page-intro">
    <h1>Connexion</h1>
    <p class="lead">Connectez-vous à votre compte pour passer commande.</p>
</div>

<div class="auth-container">
    <div class="card">
        <div class="card-content">
            {% if error %}
                <div style="padding:1rem; border-radius:1rem; background:#fee; color:#a00; border:1px solid #faa; margin-bottom:1.5rem;">
                    Identifiants invalides
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" style="display:grid; gap:1.5rem;">
                <div>
                    <label for="username" style="display:block; margin-bottom:0.5rem; font-weight:600; color:#293452;">Email</label>
                    <input
                        type="email"
                        id="username"
                        name="_username"
                        value="{{ last_username }}"
                        class="form-input"
                        required
                        autofocus
                    >
                </div>

                <div>
                    <label for="password" style="display:block; margin-bottom:0.5rem; font-weight:600; color:#293452;">Mot de passe</label>
                    <input
                        type="password"
                        id="password"
                        name="_password"
                        class="form-input"
                        required
                    >
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%; margin-top:1rem;">
                    Connexion
                </button>
            </form>

            <p style="text-align:center; margin-top:1.5rem; color:#4b5572;">
                Pas encore de compte ? <a href="#" style="color:#0d6efd; text-decoration:none; font-weight:600;">S'inscrire</a>
            </p>
        </div>
    </div>
</div>

<style>
.auth-container {
    max-width: 420px;
    margin: 2rem auto;
}

.card-content {
    padding: 2rem;
}

.form-input {
    width: 100%;
    padding: 0.95rem 1.2rem;
    border: 1px solid rgba(31,36,48,0.12);
    border-radius: 999px;
    font-size: 1rem;
    font-family: inherit;
    transition: border 0.2s ease, box-shadow 0.2s ease;
}

.form-input:focus {
    outline: 0;
    border-color: #0d6efd;
    box-shadow: 0 0 0 3px rgba(13,110,253,0.1);
}
</style>

{% endblock %}
