{% extends 'base.html.twig' %}

{% block title %}Connexion - SymHome{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="text-center mb-4">
        <h1 class="section-title">Se <span>connecter</span></h1>
        <div class="section-line mx-auto"></div>
        <p class="text-muted">Accedez a votre panier et suivez vos commandes</p>
    </div>

    <div class="card shadow-sm border-0 p-4 mx-auto" style="max-width:520px; border-radius:16px;">

        {% if error %}
            <div class="alert alert-danger rounded-3">
                <i class="bi bi-exclamation-triangle me-2"></i>{{ error }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <div class="mt-3">
                <label for="username" class="form-label">Adresse email</label>
                <input
                    type="email"
                    id="username"
                    name="_username"
                    value="{{ last_username }}"
                    class="form-control"
                    placeholder="votre@email.com"
                    autocomplete="email"
                    required
                    autofocus
                >
            </div>

            <div class="mt-3">
                <label for="password" class="form-label">Mot de passe</label>
                <input
                    type="password"
                    id="password"
                    name="_password"
                    class="form-control"
                    placeholder="Votre mot de passe"
                    autocomplete="current-password"
                    required
                >
            </div>

            <button type="submit" class="btn btn-primary-sym w-100 mt-4 py-2">
                Se connecter
            </button>
        </form>

        <p class="text-center mt-3 text-muted small">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" style="color:#c8a96e; font-weight:600;">
                S'inscrire
            </a>
        </p>

    </div>
</div>
{% endblock %}
